{
  "version": 6,
  "configurePresets": [
    {
      "name": "gui",
      "displayName": "SkinFlaps GUI",
      "binaryDir": "${sourceDir}/build/gui",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "gui-perf",
      "displayName": "SkinFlaps GUI (optimized)",
      "binaryDir": "${sourceDir}/build/gui-perf",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -mcpu=apple-m1 -flto=thin",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -mcpu=apple-m1 -flto=thin",
        "CMAKE_EXE_LINKER_FLAGS": "-flto=thin -mcpu=apple-m1",
        "CMAKE_SHARED_LINKER_FLAGS": "-flto=thin -mcpu=apple-m1"
      }
    }
  ]
}
